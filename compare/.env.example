# Copy this file to compare/.env and fill in your credentials locally.
# compare/.env is ignored by Git and is never served to the browser.
MODERN_API_KEY=
MODERN_MODEL=

# OpenAI Responses API (default). Include /v1, but not /responses.
MODERN_BASE_URL=https://api.openai.com/v1
MODERN_API_FORMAT=responses

# For a provider using the Chat Completions request format, set:
# MODERN_API_FORMAT=chat-completions
# MODERN_BASE_URL=https://your-provider.example/v1

PORT=8787
